# Скопируй в .env и заполни
# cp .env.example .env

# --- Пути к данным TorrentMonitor (обязательно) ---
# Папка где лежит tm.sqlite (и config.xml если есть)
TM_DATA_DIR=/path/to/torrentmonitor/data
# Папка с торрент-файлами
TM_TORRENTS_DIR=/path/to/torrents

# --- Порт TorrentMonitor ---
TM_PORT=8080

# --- Telegram (нужно только если запускаешь бота) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_IDS=123456789

# --- TorrentMonitor ---
TM_HTTP_PASSWORD=admin

# --- Опционально ---
TM_PAGE_SIZE=10
TM_POLL_INTERVAL=300
TMDB_API_KEY=

TZ=Europe/Moscow
