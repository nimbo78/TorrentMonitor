# Adapter selection (default: http)
TM_ADAPTER=http                   # http | db

# --- HTTP adapter ---
TM_HTTP_URL=http://localhost:8080
TM_HTTP_PASSWORD=admin

# --- DB adapter ---
TM_DB_TYPE=sqlite                 # sqlite | mysql | pgsql
TM_DB_PATH=/data/htdocs/db/tm.sqlite
# MySQL / PostgreSQL only:
TM_DB_HOST=localhost
TM_DB_PORT=3306
TM_DB_NAME=torrentmonitor
TM_DB_USER=torrentmonitor
TM_DB_PASSWORD=secret

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_IDS=123456789,987654321

# --- Optional ---
TM_PAGE_SIZE=10           # items per /list page (default: 10)
TM_POLL_INTERVAL=300      # notification polling interval in seconds (default: 300)
TMDB_API_KEY=             # leave empty to disable poster images
