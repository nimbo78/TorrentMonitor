# Скопируй в .env и заполни
# cp .env.example .env

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Telegram ID кому бот будет отвечать (можно несколько через запятую)
TELEGRAM_ALLOWED_IDS=123456789

# --- TorrentMonitor ---
# URL существующего TM (с http/https и портом если нестандартный)
TM_HTTP_URL=https://torrentmonitor.example.com
TM_HTTP_PASSWORD=admin

# --- Опционально ---
# Раздач на странице в /list
TM_PAGE_SIZE=10
# Как часто проверять новые раздачи (секунды)
TM_POLL_INTERVAL=300
# TMDB API key для постеров в уведомлениях (оставь пустым чтобы отключить)
TMDB_API_KEY=

TZ=Europe/Moscow
